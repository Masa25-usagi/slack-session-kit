# Slack Session Kit - Environment Variables Example
# NOTE: slack-session-kit DOES NOT automatically load .env files.
# Set these variables in your shell environment, container, or export them before running.

# --- Authentication (Choose one) ---

# Option A: Browser Session (No Slack App required)
# Token starting with 'xoxc-' from browser developer tools
SLACK_SESSION_TOKEN=xoxc-your-slack-session-token
# The 'd' cookie value starting with 'xoxd-' from browser developer tools
SLACK_COOKIE_D=xoxd-your-d-cookie-value

# Option B: Slack App OAuth Token (User token or Bot token)
# SLACK_TOKEN=xoxp-your-user-token
# SLACK_TOKEN=xoxb-your-bot-token

# --- Safety & Permissions (Default is read-only) ---
# Precedence: Explicit SDK constructor / CLI option > Environment variable > Default (false)

# Set to 'true' or '1' only when you explicitly opt-in to write operations
SLACK_ALLOW_WRITE=false

# Set to 'true' or '1' only when you explicitly opt-in to internal experimental APIs
SLACK_ALLOW_EXPERIMENTAL=false

# --- Optional Configurations ---
# Request timeout in milliseconds (default: 15000)
# SLACK_TIMEOUT_MS=15000
